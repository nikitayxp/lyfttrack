{
  "cleanUrls": true,
  "headers": [
    {
      "source": "/_expo/static/js/web/:asset([A-Za-z0-9_-]+-[a-f0-9]{32}\\.js)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/:path((?!_expo/).*)",
      "destination": "/"
    }
  ]
}
